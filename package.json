{
  "name": "cloude",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Cloudé — nền tảng lưu trữ và chia sẻ ảnh gốc chất lượng cao",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "verify": "npm run typecheck && npm run build",
    "verify:zip": "node --experimental-strip-types scripts/verify-zip.mts",
    "verify:checksum": "node --experimental-strip-types scripts/verify-checksum.mts",
    "verify:batches": "node --experimental-strip-types scripts/verify-batches.mts",
    "verify:supabase": "node --experimental-strip-types scripts/build-setup-sql.mts --check",
    "verify:archive": "npm run build && node --experimental-strip-types scripts/verify-archive.mts",
    "verify:worker": "tsc -p worker/tsconfig.json --noEmit",
    "worker:dev": "npm run build && cd worker && wrangler dev --port 8787 --local",
    "worker:db:init": "cd worker && wrangler d1 execute cloude-archive --local --file=src/db/schema.sql",
    "worker:db:init:remote": "cd worker && wrangler d1 execute cloude-archive --remote --file=src/db/schema.sql",
    "worker:deploy": "npm run build && cd worker && wrangler deploy",
    "worker:types": "cd worker && wrangler types",
    "worker:secrets": "cd worker && wrangler secret put OWNER_TOKEN",
    "worker:cost": "node --experimental-strip-types worker/scripts/cost-model.mts",
    "supabase:setup-sql": "node --experimental-strip-types scripts/build-setup-sql.mts",
    "supabase:login": "supabase login",
    "supabase:link": "supabase link",
    "supabase:push": "supabase db push",
    "supabase:deploy": "supabase functions deploy share",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:status": "supabase status"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.58.0",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tus-js-client": "^4.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jszip": "^3.10.2",
    "supabase": "^2.121.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "wrangler": "^4.151.1"
  }
}
