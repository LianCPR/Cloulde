[TEMPLATE]
# ─────────────────────────────────────────────────────────────
#  Cloudé — biến môi trường
#  Sao chép tệp này thành `.env.local` rồi điền giá trị thật.
#  KHÔNG bao giờ commit `.env.local`.
#
#  Chỉ cần MỘT trong hai chế độ lưu trữ:
#    • Mục 1–5  : Supabase (Postgres + Storage + Auth) — ảnh gốc ≤ 50MB/tệp ở gói Free.
#    • Mục 6    : Kho lưu trữ riêng trên Cloudflare R2 — ảnh gốc tới hàng trăm MB.
#  Không cấu hình gì: ứng dụng chạy ở chế độ demo cục bộ (IndexedDB).
# ─────────────────────────────────────────────────────────────

# ── 1. Supabase (bắt buộc cho chế độ sản xuất) ───────────────
# Lấy tại: Supabase Dashboard → Project Settings → API
# Chỉ dùng 2 khoá CÔNG KHAI dưới đây ở phía trình duyệt.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# TUYỆT ĐỐI KHÔNG đặt service_role key ở đây.
# service_role chỉ được dùng trong Supabase Edge Function (server-side).

# ── 2. Tên bucket lưu trữ ────────────────────────────────────
# Ảnh gốc (bất biến, không nén lại)
VITE_ORIGINALS_BUCKET=photo-originals
# Ảnh thu nhỏ sinh thêm cho lưới thư viện (có thể xoá và tạo lại bất cứ lúc nào)
VITE_THUMBNAILS_BUCKET=photo-thumbnails
# Gói ZIP tạm thời cho tải hàng loạt rất lớn (tự hết hạn)
VITE_ARCHIVES_BUCKET=photo-archives

# ── 3. Giới hạn & hành vi (tuỳ chọn) ────────────────────────
# Kích thước tối đa mỗi ảnh gốc, tính bằng byte.
# Gói Supabase Free: 50MB (52428800). Gói Pro: có thể đặt tới 500GB.
VITE_MAX_UPLOAD_BYTES=52428800
# Số tệp tải lên song song (1–8)
VITE_UPLOAD_CONCURRENCY=3
# Số tệp tải về song song khi tạo ZIP / tải hàng loạt (1–8)
VITE_DOWNLOAD_CONCURRENCY=4
# Ngưỡng cảnh báo trước khi tạo ZIP nhiều GB (byte)
VITE_ZIP_WARN_BYTES=1073741824
# Giới hạn cứng của ZIP phía trình duyệt (byte)
VITE_ZIP_MAX_BYTES=4294967296
# Số tệp tối đa trong một ZIP phía trình duyệt
VITE_ZIP_MAX_FILES=2000

# ── 4. Chế độ phát triển không có Supabase ──────────────────
# Mặc định (không đặt biến này): có cấu hình kho lưu trữ → archive, có Supabase
# → supabase, không có gì → local. Ứng dụng tự phát hiện.
# Chỉ bỏ ghi chú dòng dưới khi bạn MUỐN ép một chế độ cụ thể.
# VITE_BACKEND=local
#
# LƯU Ý khi deploy: tệp `.env.production` (có trong repo) đã ép `vite build`
# chạy ở chế độ `archive` — Worker phục vụ cả trang web lẫn API thì không cần
# cấu hình gì thêm. `.env.local` KHÔNG đi theo repo, nên dựa vào nó lúc build
# là nguyên nhân kinh điển khiến bản deploy rơi vào chế độ demo cục bộ.

# ── 5. Edge Function chia sẻ (server-side, tuỳ chọn) ────────
# Tên function xử lý liên kết chia sẻ + cấp signed URL.
VITE_SHARE_FUNCTION=share

# ── 6. KHO LƯU TRỮ RIÊNG (Worker + Cloudflare R2) ───────────
# Dùng cho ảnh gốc tới hàng trăm MB. Xem docs/kho-luu-tru.md.

# Địa chỉ Worker. ĐỂ TRỐNG nếu Worker phục vụ luôn trang này (cùng origin —
# cách này tránh mọi vấn đề CORS và không cần cấu hình thêm).
# Đặt giá trị này cũng khiến ứng dụng tự chọn backend `archive`.
# VITE_ARCHIVE_URL=https://kho.example.com

# Trần kích thước MỘT tệp, tính bằng byte. Không phải hạn mức của ứng dụng:
# suy ra từ giới hạn thật của R2 (10.000 phần × 64 MiB). Mặc định ≈ 640 GB.
# VITE_ARCHIVE_MAX_FILE_BYTES=671000000000

# TUYỆT ĐỐI KHÔNG đặt token chủ kho ở đây: biến VITE_* được nhúng vào bundle và
# ai cũng đọc được. Token được nhập ở màn hình /connect và chỉ lưu trong
# localStorage của trình duyệt người dùng. Tốt hơn nữa: dùng Cloudflare Access
# đứng trước Worker để không có token nào trong trình duyệt.

# ── 7. Cấu hình phía Worker (worker/wrangler.toml + worker/.dev.vars) ──
# Các giá trị sau KHÔNG thuộc về frontend, chỉ đọc được từ phía server:
#
#   ── Xác thực chủ kho (chọn MỘT, đặt cả hai cũng được) ──
#   ARCHIVE_TOKEN      bí mật — npx wrangler secret put ARCHIVE_TOKEN
#                      Dán một lần ở /connect; lưu trong localStorage trình duyệt.
#   CF_ACCESS_TEAM_DOMAIN  ví dụ `myteam.cloudflareaccess.com`.
#   CF_ACCESS_AUD          Application Audience (AUD) Tag của ứng dụng Access.
#                      Khi đặt ĐỦ hai biến này, Worker xác minh chữ ký RS256 của
#                      JWT do Access cấp (khoá công khai tải từ
#                      https://<team-domain>/cdn-cgi/access/certs) rồi mới tin.
#                      Nhờ vậy KHÔNG cần token nào trong trình duyệt — để trống ô
#                      token ở /connect. Đây là cách khuyến nghị cho môi trường thật.
#                      Chữ ký sai thì bị từ chối; không lấy được khoá thì từ chối
#                      (fail closed), không bao giờ cho qua.
#
#   LINK_SECRET        bí mật — khoá ký HMAC cho URL tải xuống có thời hạn
#   PLAN_STORAGE_GB    ngưỡng CẢNH BÁO theo gói (không bao giờ chặn tải lên)
#   PLAN_CLASS_A_MILLIONS / PLAN_CLASS_B_MILLIONS  ngưỡng cảnh báo theo tháng
#   PRICE_PER_GB_MONTH_USD / PRICE_PER_MILLION_CLASS_A_USD /
#   PRICE_PER_MILLION_CLASS_B_USD  đơn giá dùng để ƯỚC TÍNH chi phí hiển thị
#   MAINTENANCE_BATCH  số ảnh xác minh SHA-256 mỗi lần chạy bảo trì (mặc định 10)
