# Chỉ dùng cho `supabase functions serve` khi chạy local.
# Không commit file .env.local chứa giá trị thật.
# Khi deploy, Supabase tự inject SUPABASE_URL và SUPABASE_SERVICE_ROLE_KEY.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-from-dashboard

# Tuỳ chọn
SURVEY_ID=pulse-v1
# Origin được phép gửi bài. "null" cho phép mở file HTML trực tiếp.
# Khi có tên miền thật, thay bằng https://ten-mien-cua-ban.
ALLOWED_ORIGINS=http://localhost:8099,http://127.0.0.1:8099,http://localhost:5173,http://127.0.0.1:5173,null
RATE_LIMIT_PEPPER=change-me-to-a-long-random-string

# Chỉ dùng cho Edge Function admin-responses (trang quản trị).
# Đặt cùng giá trị trong Supabase → Edge Functions → Secrets khi deploy.
ADMIN_PASSWORD=change-me-to-a-long-random-string
# Origin được phép mở trang quản trị (site Freebuff Sites + local khi phát triển).
ADMIN_ALLOWED_ORIGINS=https://site-913e30905f4d43fc8537349cb481ee3c.freebuff.page,https://site-9743fcf828454f32be53f2367755dc3b.freebuff.page,http://localhost:8099
