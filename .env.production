# Build production (vite build) — giá trị được bake vào bundle.
#
# Vite ưu tiên theo thứ tự: biến môi trường thật > .env.production > .env.local > .env.
# `vite dev` (phát triển) KHÔNG đọc tệp này — `vite build` đọc.
#
# Quyết định hiện hành: dùng Supabase làm nơi lưu ảnh (postgres + Storage + Auth),
# KHÔNG dùng R2 cho lần này. Muốn quay lại đường R2 thì đổi:
#   VITE_BACKEND=archive
# và nạp lại các biến của đường Worker.

VITE_BACKEND=supabase

# Public credential — được nhúng vào bundle, ai cũng đọc được (đây là điều chủ đích
# của Supabase: anon key chỉ có quyền theo RLS).
VITE_SUPABASE_URL=https://lgbygyoiszechuxtknty.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxnYnlneW9pc3plY2h1eHRrbnR5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTIxODUyNDUsImV4cCI6MjEwNzc2MTI0NX0.rsm5cOdGVCAsk_mVHOw82WDUTdRuEjk1YCq1DHZmKJo

# TUYỆT ĐỐI KHÔNG đặt service_role key hay sb_secret ở đây: VITE_* được nhúng
# vào bundle và ai cũng đọc được. Edge Function (server-side) mới dùng service_role.
